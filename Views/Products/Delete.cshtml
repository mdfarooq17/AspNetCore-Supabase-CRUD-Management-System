@model SupabaseCrudLab.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}
<h1>Delete Product</h1>
<h3>Are you sure you want to delete this?</h3>
<hr />
<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Price</dt><dd class="col-sm-9">@Model.Price.ToString("0.00")</dd>
    <dt class="col-sm-3">Stock Quantity</dt><dd class="col-sm-9">@Model.StockQuantity</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
