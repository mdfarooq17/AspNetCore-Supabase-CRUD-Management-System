@model SupabaseCrudLab.Models.Product
@{
    ViewData["Title"] = "Product Details";
}
<h1>Product Details</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">Id</dt><dd class="col-sm-9">@Model.Id</dd>
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Price</dt><dd class="col-sm-9">@Model.Price.ToString("0.00")</dd>
    <dt class="col-sm-3">Stock Quantity</dt><dd class="col-sm-9">@Model.StockQuantity</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
